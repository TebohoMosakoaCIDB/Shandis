@page "/u/{UserName}/{Relationship}"
@inject Shandis.Web.Services.ShandisAuthService AuthService
@inject Shandis.Web.Services.ShandisApiClient ApiClient

<PageTitle>@(IsFollowers ? "Followers" : "Following") · Shandis</PageTitle>

<div class="follow-list-page">
    <a class="back-link" href="@($"/u/{Uri.EscapeDataString(UserName)}")">← Back to profile</a>
    <header>
        <h1>@(IsFollowers ? "Followers" : "Following")</h1>
        @if (result is not null)
        {
            <span>@result.TotalCount</span>
        }
    </header>

    @if (isLoading)
    {
        <div class="state">Loading members…</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="state">@errorMessage</div>
    }
    else if (result is null || result.Users.Count == 0)
    {
        <div class="state">No members to show yet.</div>
    }
    else
    {
        <section class="member-list">
            @foreach (var member in result.Users)
            {
                <a class="member-row" href="@($"/u/{Uri.EscapeDataString(member.UserName)}")">
                    @if (!string.IsNullOrWhiteSpace(member.ProfilePictureUrl))
                    {
                        <img src="@member.ProfilePictureUrl" alt="" />
                    }
                    else
                    {
                        <span class="avatar">@GetInitials(member.DisplayName)</span>
                    }
                    <span class="member-details">
                        <strong>@member.DisplayName</strong>
                        <small>@@@member.UserName</small>
                    </span>
                    <span class="view-profile">View profile</span>
                </a>
            }
        </section>
        @if (result.TotalPages > 1)
        {
            <div class="pagination">
                <button disabled="@(page <= 1)" @onclick="PreviousPageAsync">Previous</button>
                <span>Page @page of @result.TotalPages</span>
                <button disabled="@(page >= result.TotalPages)" @onclick="NextPageAsync">Next</button>
            </div>
        }
    }
</div>

<style>
    .follow-list-page{max-width:680px;margin:0 auto;padding:25px 0 60px;color:var(--shandis-text)}
    .back-link{color:var(--shandis-primary);font-size:11px;font-weight:800;text-decoration:none}
    header{display:flex;align-items:center;gap:12px;margin:22px 0 17px}
    header h1{margin:0;font:850 27px Manrope,sans-serif;letter-spacing:-.04em}
    header span{padding:4px 9px;border-radius:20px;background:var(--shandis-primary-soft);color:var(--shandis-primary);font-size:10px;font-weight:800}
    .member-list{overflow:hidden;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:15px}
    .member-row{display:flex;align-items:center;gap:12px;padding:13px 16px;color:inherit;text-decoration:none;border-bottom:1px solid var(--shandis-border)}
    .member-row:last-child{border-bottom:0}
    .member-row img,.avatar{width:43px;height:43px;flex:0 0 43px;border-radius:50%;object-fit:cover}
    .avatar{display:grid;place-items:center;background:var(--shandis-primary-soft);color:var(--shandis-primary);font-size:13px;font-weight:850}
    .member-details{display:flex;flex:1;min-width:0;flex-direction:column;gap:4px}
    .member-details strong{font-size:12px}.member-details small{color:var(--shandis-text-muted);font-size:10px}
    .view-profile{color:var(--shandis-primary);font-size:10px;font-weight:800}
    .state{padding:40px 20px;text-align:center;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:15px;color:var(--shandis-text-muted);font-size:11px}
    .pagination{display:flex;justify-content:center;align-items:center;gap:16px;margin-top:18px;font-size:10px}
    .pagination button{padding:8px 13px;border:1px solid var(--shandis-border);border-radius:8px;background:var(--shandis-surface);color:var(--shandis-text);font-weight:700}
    .pagination button:disabled{opacity:.4}
</style>

@code {
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string Relationship { get; set; } = string.Empty;

    private FollowUsersResponse? result;
    private int page = 1;
    private bool isLoading = true;
    private bool initialized;
    private string? errorMessage;

    private bool IsFollowers => string.Equals(Relationship, "followers", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthService.InitializeAsync();
        initialized = true;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!initialized)
            return;

        page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var profile = await ApiClient.GetUserProfileAsync(UserName);
            if (profile is null)
            {
                errorMessage = "We couldn't find that member.";
                result = null;
            }
            else if (IsFollowers)
            {
                result = await ApiClient.GetFollowersAsync(profile.Id, page);
            }
            else if (string.Equals(Relationship, "following", StringComparison.OrdinalIgnoreCase))
            {
                result = await ApiClient.GetFollowingAsync(profile.Id, page);
            }
            else
            {
                errorMessage = "That member list doesn't exist.";
                result = null;
            }
        }
        catch
        {
            errorMessage = "We couldn't load this member list. Please try again.";
            result = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PreviousPageAsync()
    {
        if (page <= 1) return;
        page--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (result is null || page >= result.TotalPages) return;
        page++;
        await LoadAsync();
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();

        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : "S";
    }
}