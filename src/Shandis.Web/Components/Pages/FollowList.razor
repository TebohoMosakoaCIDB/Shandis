@page "/u/{UserName}/{Relationship}"
@inject Shandis.Web.Services.ShandisAuthService AuthService
@inject Shandis.Web.Services.ShandisApiClient ApiClient

<PageTitle>@(IsFollowers ? "Followers" : "Following") · Shandis</PageTitle>

<div class="follow-list-currentPage">
    <a class="back-link" href="@($"/u/{Uri.EscapeDataString(UserName)}")">← Back to profile</a>

    @if (viewedProfile is not null)
    {
        <section class="profile-context">
            @if (!string.IsNullOrWhiteSpace(viewedProfile.ProfilePictureUrl))
            {
                <img class="profile-avatar" src="@viewedProfile.ProfilePictureUrl" alt="@($"{GetDisplayName(viewedProfile)} profile picture")" />
            }
            else
            {
                <span class="profile-avatar profile-avatar-fallback">@GetInitials(GetDisplayName(viewedProfile))</span>
            }
            <div class="profile-identity">
                <span class="eyebrow">@(IsFollowers ? "Followers of" : "Following")</span>
                <h1>@GetDisplayName(viewedProfile)</h1>
                <span class="profile-username">@@@viewedProfile.UserName</span>
                @if (!string.IsNullOrWhiteSpace(viewedProfile.Bio))
                {
                    <p>@viewedProfile.Bio</p>
                }
            </div>
        </section>

        <header class="list-heading">
            <h2>@(IsFollowers ? "Followers" : "Following")</h2>
            @if (result is not null)
            {
                <span>@result.TotalCount</span>
            }
        </header>
    }

    @if (isLoading)
    {
        <div class="state">Loading members…</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="state">@errorMessage</div>
    }
    else if (result is null || result.Users.Count == 0)
    {
        <div class="state">@(IsFollowers ? "No one follows this member yet." : "This member isn't following anyone yet.")</div>
    }
    else
    {
        <section class="member-list">
            @foreach (var member in result.Users)
            {
                <a class="member-row" href="@($"/u/{Uri.EscapeDataString(member.UserName)}")">
                    @if (!string.IsNullOrWhiteSpace(member.ProfilePictureUrl))
                    {
                        <img src="@member.ProfilePictureUrl" alt="" />
                    }
                    else
                    {
                        <span class="avatar">@GetInitials(member.DisplayName)</span>
                    }
                    <span class="member-details">
                        <strong>@member.DisplayName</strong>
                        <small>@@@member.UserName</small>
                    </span>
                    <span class="view-profile">View profile</span>
                </a>
            }
        </section>
        @if (result.TotalPages > 1)
        {
            <div class="pagination">
                <button disabled="@(currentPage <= 1)" @onclick="PreviousPageAsync">Previous</button>
                <span>Page @currentPage of @result.TotalPages</span>
                <button disabled="@(currentPage >= result.TotalPages)" @onclick="NextPageAsync">Next</button>
            </div>
        }
    }
</div>

<style>
    .follow-list-currentPage{max-width:680px;margin:0 auto;padding:25px 0 60px;color:var(--shandis-text)}
    .back-link{color:var(--shandis-primary);font-size:11px;font-weight:800;text-decoration:none}
    .profile-context{display:flex;align-items:center;gap:17px;margin:23px 0 25px;padding:20px;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:17px}
    .profile-avatar{width:76px;height:76px;flex:0 0 76px;border-radius:50%;object-fit:cover}
    .profile-avatar-fallback{display:grid;place-items:center;background:var(--shandis-primary-soft);color:var(--shandis-primary);font-size:22px;font-weight:850}
    .profile-identity{min-width:0}
    .eyebrow{display:block;margin-bottom:4px;color:var(--shandis-text-muted);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.09em}
    .profile-identity h1{margin:0;font:850 23px Manrope,sans-serif;letter-spacing:-.04em}
    .profile-username{display:block;margin-top:3px;color:var(--shandis-text-muted);font-size:11px}
    .profile-identity p{margin:9px 0 0;font-size:12px;line-height:1.5}
    .list-heading{display:flex;align-items:center;gap:10px;margin:0 0 14px}
    .list-heading h2{margin:0;font:800 17px Manrope,sans-serif}
    .list-heading span{padding:4px 9px;border-radius:20px;background:var(--shandis-primary-soft);color:var(--shandis-primary);font-size:10px;font-weight:800}
    .member-list{overflow:hidden;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:15px}
    .member-row{display:flex;align-items:center;gap:12px;padding:13px 16px;color:inherit;text-decoration:none;border-bottom:1px solid var(--shandis-border)}
    .member-row:last-child{border-bottom:0}
    .member-row img,.avatar{width:43px;height:43px;flex:0 0 43px;border-radius:50%;object-fit:cover}
    .avatar{display:grid;place-items:center;background:var(--shandis-primary-soft);color:var(--shandis-primary);font-size:13px;font-weight:850}
    .member-details{display:flex;flex:1;min-width:0;flex-direction:column;gap:4px}
    .member-details strong{font-size:12px}.member-details small{color:var(--shandis-text-muted);font-size:10px}
    .view-profile{color:var(--shandis-primary);font-size:10px;font-weight:800}
    .state{padding:40px 20px;text-align:center;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:15px;color:var(--shandis-text-muted);font-size:11px}
    .pagination{display:flex;justify-content:center;align-items:center;gap:16px;margin-top:18px;font-size:10px}
    .pagination button{padding:8px 13px;border:1px solid var(--shandis-border);border-radius:8px;background:var(--shandis-surface);color:var(--shandis-text);font-weight:700}
    .pagination button:disabled{opacity:.4}
    @@media(max-width:600px){.follow-list-currentPage{padding-top:18px}.profile-context{gap:13px;padding:15px}.profile-avatar{width:62px;height:62px;flex-basis:62px}.profile-identity h1{font-size:19px}}
</style>

@code {
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string Relationship { get; set; } = string.Empty;

    private UserProfileItem? viewedProfile;
    private FollowUsersResponse? result;
    private int currentPage = 1;
    private bool isLoading = true;
    private bool initialized;
    private string? errorMessage;

    private bool IsFollowers => string.Equals(Relationship, "followers", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthService.InitializeAsync();
        initialized = true;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!initialized)
            return;

        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            viewedProfile = await ApiClient.GetUserProfileAsync(UserName);
            if (viewedProfile is null)
            {
                errorMessage = "We couldn't find that member.";
                result = null;
            }
            else if (IsFollowers)
            {
                result = await ApiClient.GetFollowersAsync(viewedProfile.Id, currentPage);
            }
            else if (string.Equals(Relationship, "following", StringComparison.OrdinalIgnoreCase))
            {
                result = await ApiClient.GetFollowingAsync(viewedProfile.Id, currentPage);
            }
            else
            {
                errorMessage = "That member list doesn't exist.";
                result = null;
            }
        }
        catch
        {
            errorMessage = "We couldn't load this member list. Please try again.";
            result = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (result is null || currentPage >= result.TotalPages) return;
        currentPage++;
        await LoadAsync();
    }

    private static string GetDisplayName(UserProfileItem profile)
        => !string.IsNullOrWhiteSpace(profile.DisplayName)
            ? profile.DisplayName
            : profile.UserName;

    private static string GetInitials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();

        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : "S";
    }
}