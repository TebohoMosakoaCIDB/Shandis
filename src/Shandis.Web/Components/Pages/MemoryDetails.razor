@page "/memories/{MemoryId:guid}"
@inject Shandis.Web.Services.ShandisAuthService AuthService
@inject Shandis.Web.Services.ShandisApiClient ApiClient

<PageTitle>@(memory?.Title ?? "Memory") · Shandis</PageTitle>

<div class="memory-details-page">
    <a class="back-link" href="/memories">← Back to my memories</a>

    @if (isLoading)
    {
        <div class="detail-state"><span class="loading-pulse"></span><p>Opening this memory…</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="detail-state state-error">
            <h2>@(notFound ? "Memory not found" : "We couldn't open this memory")</h2>
            <p>@errorMessage</p>
            <a class="shandis-btn shandis-btn-secondary" href="/memories">Back to my memories</a>
        </div>
    }
    else if (memory is not null)
    {
        <section class="memory-profile">
            <div class="memory-profile-art @(string.IsNullOrWhiteSpace(memory.CoverImageUrl) ? "" : "has-cover-image")">
                @if (!string.IsNullOrWhiteSpace(memory.CoverImageUrl))
                {
                    <img class="memory-cover-art-image" src="@memory.CoverImageUrl" alt="@($"{memory.Title} cover image")" />
                    <span class="memory-cover-art-shade"></span>
                }
                <span class="profile-art-mark">✳</span>
                <span class="profile-art-label">ONE EXPERIENCE. MANY PERSPECTIVES.</span>
                @if (canManageInvitations)
                {
                    <div class="cover-art-actions">
                        <label class="cover-upload-button">
                            @(isUpdatingCover ? "Uploading…" : "Change cover")
                            <InputFile OnChange="UploadCoverImageAsync" accept="image/jpeg,image/png,image/webp" disabled="@isUpdatingCover" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(memory.CoverImageUrl))
                        {
                            <button type="button" class="cover-remove-button" @onclick="RemoveCoverImageAsync" disabled="@isUpdatingCover">Remove</button>
                        }
                    </div>
                }
            </div>
            <div class="memory-profile-content">
                <div class="memory-profile-avatar">@Initials(memory?.Title ?? "Shandis")</div>
                <div class="memory-profile-main">
                    <div class="memory-profile-kicker">
                        <span>@(memory.Visibility == 2 ? "PRIVATE MEMORY" : "PUBLIC MEMORY")</span>
                        @if (!string.IsNullOrWhiteSpace(memory.CategoryName))
                        {
                            <span>@memory.CategoryName</span>
                        }
                    </div>
                    <h1>@memory.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(memory.Description))
                    {
                        <p class="memory-description">@memory.Description</p>
                    }
                    <div class="memory-profile-meta">
                        @if (!string.IsNullOrWhiteSpace(memory.PlaceName))
                        {
                            <span>⌖ @memory.PlaceName</span>
                        }
                        @if (memory.StartDateUtc.HasValue)
                        {
                            <span>◷ @memory.StartDateUtc.Value.ToLocalTime().ToString("d MMMM yyyy")</span>
                        }
                    </div>
                </div>
                <div class="memory-profile-count">
                    <strong>@momentsTotal</strong>
                    <span>@(momentsTotal == 1 ? "moment" : "moments")</span>
                </div>
            </div>
            <div class="memory-profile-actions">
                <div class="memory-profile-stat"><strong>@galleryItems.Count</strong><span>Media</span></div>
                <div class="memory-profile-stat"><strong>@momentsTotal</strong><span>Moments</span></div>
                <span class="memory-profile-spacer"></span>
                <button class="shandis-btn shandis-btn-secondary" @onclick="ToggleSavedMemoryAsync" disabled="@isSavingMemory">@(isSavingMemory ? "Saving…" : isMemorySaved ? "♥ Saved" : "♡ Save Memory")</button>
                <span class="memory-status status-@memory.Status">@MemoryStatusText(memory.Status)</span>
                @if (canManageInvitations && memory.Status == 1)
                {
                    <button class="shandis-btn shandis-btn-primary" @onclick="PublishMemoryAsync" disabled="@isPublishing">
                        @(isPublishing ? "Publishing…" : "Publish Memory")
                    </button>
                }
                @if (CanAddMoment)
                {
                    <a class="shandis-btn shandis-btn-primary" href="@($"/memories/{MemoryId}/moments/create")">＋ Add a moment</a>
                }
                else if (memory.Status == 1)
                {
                    <span class="publish-waiting">Waiting for the owner to publish this Memory.</span>
                }
                else if (memory.MyRole == 3)
                {
                    <span class="publish-waiting">You have Viewer access. You can view this Memory but cannot add Moments.</span>
                }
                else
                {
                    <span class="publish-waiting">Only invited Contributors can add Moments to this Memory.</span>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(savedMemoryMessage))
        {
            <p class="invitation-feedback">@savedMemoryMessage</p>
        }

        @if (!string.IsNullOrWhiteSpace(coverImageMessage))
        {
            <p class="invitation-feedback @(coverImageIsError ? "is-error" : "is-success")">@coverImageMessage</p>
        }

        @if (!string.IsNullOrWhiteSpace(publishMessage))
        {
            <p class="invitation-feedback @(publishIsError ? "is-error" : "is-success")">@publishMessage</p>
        }

        @if (canManageInvitations)
        {
            <section class="invitation-panel">
                <div class="invitation-heading">
                    <div>
                        <p class="eyebrow">BRING EVERYONE TOGETHER</p>
                        <h2>Invite people</h2>
                        <p>Invite someone to view or contribute to this Memory.</p>
                    </div>
                    <span class="invitation-count">@memoryInvitations.Count invitations</span>
                </div>

                <form class="invitation-form" @onsubmit="SendInvitationAsync" @onsubmit:preventDefault>
                    <label class="invitee-label">
                        <span>Find a Shandis member or invite by email</span>
                        <div class="invitee-field">
                            <input type="text"
                                   value="@inviteIdentifier"
                                   @oninput="HandleInviteInputAsync"
                                   maxlength="320"
                                   autocomplete="off"
                                   placeholder="Search by name or username"
                                   required />
                            @if (isSearchingMembers)
                            {
                                <div class="invitee-search-hint">Searching Shandis members…</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(memberSearchError))
                            {
                                <div class="invitee-search-hint">@memberSearchError</div>
                            }
                            else if (showMemberSuggestions && memberSearchResults.Count > 0)
                            {
                                <div class="member-suggestions" role="listbox" aria-label="Matching Shandis members">
                                    @foreach (var member in memberSearchResults)
                                    {
                                        <button type="button"
                                                class="member-suggestion"
                                                role="option"
                                                @key="member.Id"
                                                @onclick="() => SelectInvitee(member)">
                                            <span class="member-suggestion-avatar">@Initials(member.DisplayName)</span>
                                            <span class="member-suggestion-details">
                                                <strong>@member.DisplayName</strong>
                                                <small>@@@member.UserName</small>
                                            </span>
                                            <span class="member-suggestion-select">Select</span>
                                        </button>
                                    }
                                </div>
                            }
                            else if (showMemberSuggestions && inviteIdentifier.Trim().TrimStart('@').Length >= 2)
                            {
                                <div class="invitee-search-hint">
                                    No matching Shandis member found. If they're not on Shandis yet, enter their email address instead.
                                </div>
                            }
                        </div>
                        @if (selectedInvitee is not null)
                        {
                            <small class="selected-invitee">Inviting <strong>@selectedInvitee.DisplayName</strong> ( @@@selectedInvitee.UserName )</small>
                        }
                        else
                        {
                            <small class="invitee-help">Registered members appear as you type. To invite someone new, enter their email address.</small>
                        }
                    </label>
                    <label>
                        <span>Access</span>
                        <select @bind="inviteRole">
                            <option value="2">Contributor — can add moments</option>
                            <option value="1">Viewer — can view only</option>
                        </select>
                    </label>
                    <button class="shandis-btn shandis-btn-primary" type="submit" disabled="@isSendingInvitation">
                        @(isSendingInvitation ? "Sending…" : "＋ Send invitation")
                    </button>
                </form>

                @if (!string.IsNullOrWhiteSpace(invitationMessage))
                {
                    <p class="invitation-feedback @(invitationIsError ? "is-error" : "is-success")">@invitationMessage</p>
                }

                @if (memoryInvitations.Count > 0)
                {
                    <div class="invitation-list">
                        @foreach (var invitation in memoryInvitations)
                        {
                            <div class="invitation-row" @key="invitation.Id">
                                <div class="invitation-person">
                                    <span class="invitation-avatar">@Initials(invitation.InvitedEmail)</span>
                                    <div>
                                        <strong>@invitation.InvitedEmail</strong>
                                        <span>@(invitation.AssignedRole == 2 ? "Contributor" : "Viewer") · @InvitationStatusText(invitation.Status)</span>
                                    </div>
                                </div>
                                @if (invitation.Status == 1)
                                {
                                    <button class="invitation-revoke" @onclick="() => RevokeInvitationAsync(invitation.Id)" disabled="@busyInvitationIds.Contains(invitation.Id)">
                                        Revoke
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(invitationLoadError))
                {
                    <p class="invitation-feedback is-error">@invitationLoadError</p>
                }
                <p class="invitation-note">Choose a registered member from the search suggestions, or enter an email address to invite someone who has not joined Shandis. If an invitation already exists, its role and status are updated. The member must accept again; their existing Moments and comments are retained. Invitations expire after 7 days.</p>
            </section>
        }

        <section class="gallery-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">COLLECTED PERSPECTIVES</p>
                    <h2>The gallery</h2>
                    <p>Photos and videos shared by everyone in this Memory.</p>
                </div>
                <div class="gallery-filters" role="group" aria-label="Filter gallery">
                    <button class="@FilterClass("all")" @onclick='() => SetGalleryFilter("all")'>All</button>
                    <button class="@FilterClass("photo")" @onclick='() => SetGalleryFilter("photo")'>Photos</button>
                    <button class="@FilterClass("video")" @onclick='() => SetGalleryFilter("video")'>Videos</button>
                </div>
            </div>

            @if (FilteredGalleryItems.Count == 0)
            {
                <div class="gallery-empty">
                    <span>▧</span>
                    <h3>@(galleryItems.Count == 0 ? "The gallery is ready for its first moment." : "No media in this filter yet.")</h3>
                    <p>@(galleryItems.Count == 0 ? "When people add photos and videos, they'll come together here." : "Try another filter to see more of this Memory.")</p>
                </div>
            }
            else
            {
                <div class="gallery-grid">
                    @foreach (var item in FilteredGalleryItems)
                    {
                        <div class="gallery-tile" role="button" tabindex="0" @key="item.Media.Id" @onclick="() => OpenGallery(item)" aria-label="View media from @item.Moment.Title">
                            @if (item.IsVideo)
                            {
                                <video src="@item.Media.Url" muted preload="metadata" playsinline></video>
                                <span class="tile-video-icon">▶</span>
                            }
                            else
                            {
                                <img src="@item.Media.Url" alt="@item.Media.FileName" loading="lazy" />
                            }
                            <span class="tile-comment-count" aria-label="@item.Moment.CommentCount comments">
                                ◯ @item.Moment.CommentCount
                            </span>
                            <span class="tile-overlay">
                                <span>♡ @item.Moment.LikeCount</span>
                                <span>◯ @item.Moment.CommentCount</span>
                                <span>↗ View</span>
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="moments-section">
            <div class="section-heading moments-section-heading">
                <div>
                    <p class="eyebrow">THE STORY SO FAR</p>
                    <h2>Recent moments</h2>
                    <p>Every perspective adds something to the memory.</p>
                </div>
            </div>
            @if (memory?.MyRole == 1 && moments.Any(moment => moment.Status == 2))
            {
                <p class="moderation-help">You have @moments.Count(moment => moment.Status == 2) contribution(s) waiting for approval. Approve them to make them visible to everyone who can view this Memory.</p>
            }
            @if (!string.IsNullOrWhiteSpace(moderationMessage))
            {
                <p class="invitation-feedback @(moderationIsError ? "is-error" : "is-success")">@moderationMessage</p>
            }

            @if (moments.Count == 0)
            {
                <div class="gallery-empty">
                    <span>✳</span>
                    <h3>The first moment is waiting.</h3>
                    <p>Photos, videos and little stories will live here together.</p>
                </div>
            }
            else
            {
                <div class="moments-feed">
                    @foreach (var moment in moments)
                    {
                        <article class="moment-post" @key="moment.Id">
                            <div class="moment-post-avatar">@Initials(memory.Title)</div>
                            <div class="moment-post-content">
                                <div class="moment-post-header">
                                    <strong>Shandis contributor</strong>
                                    <span>@(moment.HappenedAtUtc?.ToLocalTime().ToString("d MMM yyyy · HH:mm") ?? moment.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy · HH:mm"))</span>
                                </div>
                                @if (moment.Status == 2)
                                {
                                    <div class="moment-moderation">
                                        <span class="moment-pending-label">Awaiting your approval</span>
                                        @if (memory?.MyRole == 1)
                                        {
                                            <div class="moment-moderation-actions">
                                                <button class="shandis-btn shandis-btn-primary"
                                                        @onclick="() => ModerateMomentAsync(moment.Id, approve: true)"
                                                        disabled="@moderatingMomentIds.Contains(moment.Id)">
                                                    @(moderatingMomentIds.Contains(moment.Id) ? "Saving…" : "Approve")
                                                </button>
                                                <button class="shandis-btn shandis-btn-secondary"
                                                        @onclick="() => ModerateMomentAsync(moment.Id, approve: false)"
                                                        disabled="@moderatingMomentIds.Contains(moment.Id)">
                                                    Reject
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (moment.Status == 4)
                                {
                                    <div class="moment-rejected-label">
                                        <strong>Contribution not approved</strong>
                                        <span>This Moment is only visible to you and the Memory owner.</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(moment.Title))
                                {
                                    <h3>@moment.Title</h3>
                                }
                                @if (!string.IsNullOrWhiteSpace(moment.Content))
                                {
                                    <p>@moment.Content</p>
                                }
                                @if (moment.Media.Count > 0)
                                {
                                    <button class="post-media-link" @onclick="() => OpenMomentFirstMedia(moment)">
                                        @moment.Media.Count @(moment.Media.Count == 1 ? "attachment" : "attachments") · View in gallery ↗
                                    </button>
                                }
                                <div class="moment-post-actions">
                                    <button class="moment-action like-action @(moment.IsLikedByCurrentUser ? "is-liked" : "")"
                                            @onclick="() => ToggleMomentLikeAsync(moment)"
                                            disabled="@busyMomentIds.Contains(moment.Id)">
                                        @(moment.IsLikedByCurrentUser ? "♥" : "♡")
                                        @moment.LikeCount @(moment.LikeCount == 1 ? "like" : "likes")
                                    </button>
                                    <button class="moment-action" @onclick="() => ToggleCommentsAsync(moment.Id)">
                                        ◯ @moment.CommentCount @(moment.CommentCount == 1 ? "comment" : "comments")
                                    </button>
                                    <span class="moment-kind">@(moment.MomentType == 4 ? "STORY" : moment.MomentType == 5 ? "MIXED MOMENT" : "MOMENT")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(momentActionError))
                                {
                                    <p class="moment-action-error">@momentActionError</p>
                                }
                                @if (activeCommentsMomentId == moment.Id)
                                {
                                    <div class="moment-comments">
                                        @if (commentsLoading)
                                        {
                                            <p class="comments-state">Loading comments…</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(commentsError))
                                        {
                                            <p class="comments-error">@commentsError</p>
                                        }
                                        else if (activeComments.Count == 0)
                                        {
                                            <p class="comments-state">No comments yet. Start the conversation.</p>
                                        }
                                        else
                                        {
                                            @foreach (var comment in activeComments)
                                            {
                                                <div class="moment-comment" @key="comment.Id">
                                                    <div class="comment-avatar">@Initials(comment.AuthorName)</div>
                                                    <div class="comment-body">
                                                        <div class="comment-heading">
                                                            <strong>@comment.AuthorName</strong>
                                                            <span>@comment.CreatedAtUtc.ToLocalTime().ToString("d MMM · HH:mm")</span>
                                                        </div>
                                                        <p>@comment.Content</p>
                                                        @foreach (var reply in comment.Replies)
                                                        {
                                                            <div class="comment-reply" @key="reply.Id">
                                                                <strong>@reply.AuthorName</strong>
                                                                <span>@reply.Content</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        <div class="comment-composer">
                                            <input @bind="newCommentContent"
                                                   @bind:event="oninput"
                                                   maxlength="2000"
                                                   placeholder="Add a comment…" />
                                            <button class="shandis-btn shandis-btn-primary"
                                                    @onclick="() => AddCommentAsync(moment.Id)"
                                                    disabled="@(!CanPostComment || isPostingComment)">
                                                @(isPostingComment ? "Posting…" : "Post")
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>

                @if (momentsPage < momentsTotalPages)
                {
                    <div class="load-more-wrap">
                        <button class="shandis-btn shandis-btn-secondary" @onclick="LoadMoreMomentsAsync" disabled="@isLoadingMore">
                            @(isLoadingMore ? "Loading…" : "Load more moments")
                        </button>
                    </div>
                }
            }
        </section>
    }
</div>

@if (selectedGalleryItem is not null)
{
    <div class="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Memory media viewer" @onclick="CloseGallery">
        <button class="lightbox-close" @onclick="CloseGallery" aria-label="Close viewer">×</button>
        @if (selectedGalleryIndex > 0)
        {
            <button class="lightbox-nav lightbox-previous" @onclick:stopPropagation="true" @onclick="PreviousGalleryItem" aria-label="Previous media">‹</button>
        }
        <div class="lightbox-content" @onclick:stopPropagation="true">
            <div class="lightbox-media">
                @if (selectedGalleryItem.IsVideo)
                {
                    <video src="@selectedGalleryItem.Media.Url" controls autoplay playsinline></video>
                }
                else
                {
                    <img src="@selectedGalleryItem.Media.Url" alt="@selectedGalleryItem.Media.FileName" />
                }
            </div>
            <aside class="lightbox-details">
                <div class="lightbox-memory-label">✳ @memory?.Title</div>
                <div class="lightbox-author">
                    <div class="moment-post-avatar">@Initials(memory?.Title ?? "S")</div>
                    <div><strong>Shandis contributor</strong><span>@selectedGalleryItem.Moment.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy · HH:mm")</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedGalleryItem.Moment.Title))
                {
                    <h3>@selectedGalleryItem.Moment.Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(selectedGalleryItem.Moment.Content))
                {
                    <p class="lightbox-caption">@selectedGalleryItem.Moment.Content</p>
                }
                <div class="lightbox-footer">
                    <button class="moment-action like-action lightbox-like-action @(selectedGalleryItem.Moment.IsLikedByCurrentUser ? "is-liked" : "")"
                            @onclick="() => ToggleMomentLikeAsync(selectedGalleryItem.Moment)"
                            disabled="@busyMomentIds.Contains(selectedGalleryItem.Moment.Id)">
                        @(selectedGalleryItem.Moment.IsLikedByCurrentUser ? "♥" : "♡")
                        @selectedGalleryItem.Moment.LikeCount @(selectedGalleryItem.Moment.LikeCount == 1 ? "like" : "likes")
                    </button>
                    <span>◯ @selectedGalleryItem.Moment.CommentCount comments</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(momentActionError))
                {
                    <p class="moment-action-error">@momentActionError</p>
                }
                <section class="lightbox-comments" aria-label="Moment comments">
                    <div class="lightbox-comments-heading">
                        <strong>Comments</strong>
                        <span>@selectedGalleryItem.Moment.CommentCount</span>
                    </div>
                    <div class="lightbox-comments-scroll">
                        @if (galleryCommentsLoading)
                        {
                            <p class="comments-state">Loading comments…</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(galleryCommentsError))
                        {
                            <p class="comments-error">@galleryCommentsError</p>
                        }
                        else if (galleryComments.Count == 0)
                        {
                            <p class="comments-state">No comments yet. Start the conversation.</p>
                        }
                        else
                        {
                            @foreach (var comment in galleryComments)
                            {
                                <div class="moment-comment" @key="comment.Id">
                                    <div class="comment-avatar">@Initials(comment.AuthorName)</div>
                                    <div class="comment-body">
                                        <div class="comment-heading">
                                            <strong>@comment.AuthorName</strong>
                                            <span>@comment.CreatedAtUtc.ToLocalTime().ToString("d MMM · HH:mm")</span>
                                        </div>
                                        <p>@comment.Content</p>
                                        @foreach (var reply in comment.Replies)
                                        {
                                            <div class="comment-reply" @key="reply.Id">
                                                <strong>@reply.AuthorName</strong>
                                                <span>@reply.Content</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(galleryCommentError))
                    {
                        <p class="comments-error">@galleryCommentError</p>
                    }
                    <div class="comment-composer lightbox-comment-composer">
                        <input @bind="galleryNewCommentContent"
                               @bind:event="oninput"
                               maxlength="2000"
                               placeholder="Add a comment…" />
                        <button class="shandis-btn shandis-btn-primary"
                                @onclick="PostGalleryCommentAsync"
                                disabled="@(string.IsNullOrWhiteSpace(galleryNewCommentContent) || galleryCommentPosting)">
                            @(galleryCommentPosting ? "Posting…" : "Post")
                        </button>
                    </div>
                </section>
            </aside>
        </div>
        @if (selectedGalleryIndex < galleryItems.Count - 1)
        {
            <button class="lightbox-nav lightbox-next" @onclick:stopPropagation="true" @onclick="NextGalleryItem" aria-label="Next media">›</button>
        }
    </div>
}

<style>
    .memory-details-page{max-width:1000px;margin:0 auto;padding:12px 24px 90px}
    .back-link{display:inline-block;margin:0 0 17px;color:var(--shandis-text-muted);font-size:11px;font-weight:700}
    .back-link:hover{color:var(--shandis-primary)}
    .memory-profile{overflow:hidden;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:18px;box-shadow:var(--shandis-shadow)}
    .memory-profile-art{position:relative;isolation:isolate;height:145px;display:flex;align-items:center;justify-content:space-between;padding:24px 35px;color:#70473D;background:radial-gradient(circle at 75% 20%,rgba(255,255,255,.48),transparent 25%),linear-gradient(120deg,#E7B6A8,#F2D5B9 48%,#B9C9B7)}
    .memory-cover-art-image,.memory-cover-art-shade{position:absolute;inset:0;width:100%;height:100%}
    .memory-cover-art-image{z-index:-2;object-fit:cover}
    .memory-cover-art-shade{z-index:-1;background:linear-gradient(90deg,rgba(0,0,0,.22),rgba(0,0,0,.02))}
    .memory-profile-art.has-cover-image{color:white}
    .cover-art-actions{display:flex;align-items:center;gap:7px;margin-left:auto}
    .cover-upload-button,.cover-remove-button{position:relative;display:inline-flex;align-items:center;padding:8px 11px;border:1px solid rgba(255,255,255,.65);border-radius:8px;background:rgba(30,30,30,.48);color:white;font-size:9px;font-weight:850;cursor:pointer}
    .cover-upload-button input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
