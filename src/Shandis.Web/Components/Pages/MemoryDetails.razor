@code {
    [Parameter] public Guid MemoryId { get; set; }

    private Shandis.Web.Models.MemoryDetails? memory;
    private List<Shandis.Web.Models.MomentItem> moments = [];
    private List<GalleryItem> galleryItems = [];
    private bool isLoading = true;
    private bool isLoadingMore;
    private bool notFound;
    private string? errorMessage;
    private string galleryFilter = "all";
    private GalleryItem? selectedGalleryItem;
    private int selectedGalleryIndex;
    private List<Shandis.Web.Models.MomentCommentItem> galleryComments = [];
    private string galleryNewCommentContent = string.Empty;
    private bool galleryCommentsLoading;
    private bool galleryCommentPosting;
    private string? galleryCommentsError;
    private string? galleryCommentError;
    private int momentsPage = 1;
    private const int PageSize = 20;
    private int momentsTotal;
    private int momentsTotalPages;
    private bool canManageInvitations;
    private bool isPublishing;
    private bool isMemorySaved;
    private bool isSavingMemory;
    private bool isUpdatingCover;
    private string? coverImageMessage;
    private bool coverImageIsError;
    private string? savedMemoryMessage;
    private string? publishMessage;
    private bool publishIsError;
    private string? invitationLoadError;
    private List<Shandis.Web.Models.InvitationItem> memoryInvitations = [];
    private string inviteIdentifier = string.Empty;
    private int inviteRole = 2;
    private Shandis.Web.Models.MemberSearchItem? selectedInvitee;
    private List<Shandis.Web.Models.MemberSearchItem> memberSearchResults = [];
    private CancellationTokenSource? memberSearchCts;
    private bool isSearchingMembers;
    private bool showMemberSuggestions;
    private string? memberSearchError;
    private bool isSendingInvitation;
    private string? invitationMessage;
    private bool invitationIsError;
    private readonly HashSet<Guid> busyInvitationIds = [];

    private bool CanAddMoment
    {
        get
        {
            if (memory is null || memory.Status == 4)
                return false;

            // The owner can add Moments to Draft, Published and Completed Memories.
            if (memory.MyRole == 1)
                return true;

            // A Viewer is always read-only, regardless of the public contribution policy.
            if (memory.MyRole == 3 || memory.Status == 1)
                return false;

            // Private Memories and InvitationOnly public Memories require an active Contributor.
            if (memory.Visibility == 2 || memory.ContributionPolicy == 3)
                return memory.MyRole == 2;

            // Public Open and ApprovalRequired Memories accept any signed-in non-Viewer.
            return memory.Visibility == 1 &&
                   (memory.ContributionPolicy == 1 || memory.ContributionPolicy == 2);
        }
    }

    private List<GalleryItem> FilteredGalleryItems => galleryFilter switch
    {
        "photo" => galleryItems.Where(item => !item.IsVideo).ToList(),
        "video" => galleryItems.Where(item => item.IsVideo).ToList(),
        _ => galleryItems
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            await LoadMemoryAsync();
            StateHasChanged();
        }
    }

    private async Task UploadCoverImageAsync(InputFileChangeEventArgs args)
    {
        if (memory is null || !canManageInvitations || isUpdatingCover)
            return;

        var file = args.File;
        coverImageMessage = null;
        coverImageIsError = false;

        if (file.Size <= 0 || file.Size > 10 * 1024 * 1024)
        {
            coverImageMessage = "Choose an image smaller than 10 MB.";
            coverImageIsError = true;
            return;
        }

        if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            coverImageMessage = "Cover images must be JPG, PNG or WebP files.";
            coverImageIsError = true;
            return;
        }

        isUpdatingCover = true;
        try
        {
            await ApiClient.UploadMemoryCoverImageAsync(MemoryId, file);
            memory = await ApiClient.GetMemoryAsync(MemoryId);
            coverImageMessage = "Memory cover image updated.";
        }
        catch (Exception)
        {
            coverImageMessage = "We couldn't upload that cover image. Please try again.";
            coverImageIsError = true;
        }
        finally
        {
            isUpdatingCover = false;
        }
    }

    private async Task RemoveCoverImageAsync()
    {
        if (memory is null || !canManageInvitations || isUpdatingCover)
            return;

        isUpdatingCover = true;
        coverImageMessage = null;
        coverImageIsError = false;
        try
        {
            await ApiClient.RemoveMemoryCoverImageAsync(MemoryId);
            memory = await ApiClient.GetMemoryAsync(MemoryId);
            coverImageMessage = "Memory cover image removed.";
        }
        catch (Exception)
        {
            coverImageMessage = "We couldn't remove the cover image. Please try again.";
            coverImageIsError = true;
        }
        finally
        {
            isUpdatingCover = false;
        }
    }

    private async Task ToggleSavedMemoryAsync()
    {
        if (isSavingMemory) return;
        isSavingMemory = true;
        savedMemoryMessage = null;
        try
        {
            if (isMemorySaved)
            {
                await ApiClient.UnsaveMemoryAsync(MemoryId);
                isMemorySaved = false;
                savedMemoryMessage = "Removed from Saved Memories.";
            }
            else
            {
                await ApiClient.SaveMemoryAsync(MemoryId);
                isMemorySaved = true;
                savedMemoryMessage = "Added to Saved Memories.";
            }
        }
        catch
        {
            savedMemoryMessage = "We couldn't update your saved Memories. Please try again.";
        }
        finally { isSavingMemory = false; }
    }

    private async Task LoadMemoryAsync()
    {
        isLoading = true;
        errorMessage = null;
        notFound = false;

        try
        {
            memory = await ApiClient.GetMemoryAsync(MemoryId);
            if (memory is null)
            {
                notFound = true;
                errorMessage = "This Memory may have been removed, or you may no longer have access to it.";
                return;
            }

            isMemorySaved = await ApiClient.IsMemorySavedAsync(MemoryId);

            canManageInvitations = false;
            invitationLoadError = null;
            memoryInvitations = [];

            try
            {
                memoryInvitations = await ApiClient.GetMemoryInvitationsAsync(MemoryId);
                canManageInvitations = true;
            }
            catch (HttpRequestException ex)
            {
                if (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    // A 403 is expected for Contributors and Viewers.
                    // The API only permits the Memory owner to manage invitations.
                    canManageInvitations = false;
                    invitationLoadError = null;
                }
                else
                {
                    var status = ex.StatusCode.HasValue
                        ? $"HTTP {(int)ex.StatusCode.Value} ({ex.StatusCode.Value})"
                        : "HTTP request failed";

                    invitationLoadError = $"Invitations could not be loaded ({status}). Details: {ex.Message}";
                }
            }
            catch (Exception ex)
            {
                invitationLoadError = $"Invitations could not be loaded. Details: {ex.Message}";
            }

            var result = await ApiClient.GetMomentsAsync(MemoryId, 1, PageSize);
            moments = result.Moments;
            momentsPage = result.Page;
            momentsTotal = result.TotalCount;
            momentsTotalPages = result.TotalPages;
            RebuildGallery();
        }
        catch (HttpRequestException ex)
        {
            notFound = ex.StatusCode == System.Net.HttpStatusCode.NotFound;
            errorMessage = notFound
                ? "This Memory could not be found."
                : ex.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "You don't have permission to view this Memory."
                    : "Please check that the API is running and try again.";
        }
        catch (Exception)
        {
            errorMessage = "Something unexpected happened while opening this Memory.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static string MemoryStatusText(int status) => status switch
    {
        1 => "Draft",
        2 => "Published",
        3 => "Completed",
        4 => "Archived",
        _ => "Unknown"
    };

    private async Task PublishMemoryAsync()
    {
        if (!canManageInvitations || memory is null || memory.Status != 1 || isPublishing)
            return;

        isPublishing = true;
        publishMessage = null;
        publishIsError = false;

        try
        {
            await ApiClient.PublishMemoryAsync(MemoryId);
            memory = await ApiClient.GetMemoryAsync(MemoryId);

            if (memory is null)
                throw new InvalidOperationException("The Memory could not be reloaded after publishing.");

            publishMessage = "Your Memory is now published. Eligible contributors can start adding Moments.";
            var result = await ApiClient.GetMomentsAsync(MemoryId, 1, PageSize);
            moments = result.Moments;
            momentsPage = result.Page;
            momentsTotal = result.TotalCount;
            momentsTotalPages = result.TotalPages;
            RebuildGallery();
        }
        catch (Exception ex)
        {
            publishIsError = true;
            publishMessage = ex.Message;
        }
        finally
        {
            isPublishing = false;
        }
    }

    private async Task HandleInviteInputAsync(ChangeEventArgs args)
    {
        inviteIdentifier = args.Value?.ToString() ?? string.Empty;
        selectedInvitee = null;
        invitationMessage = null;
        memberSearchError = null;
        memberSearchResults = [];

        var query = inviteIdentifier.Trim();
        var isEmail = query.Contains("@", StringComparison.Ordinal) &&
                      !query.StartsWith("@", StringComparison.Ordinal);

        if (query.StartsWith("@", StringComparison.Ordinal))
            query = query.TrimStart('@');

        if (query.Length < 2 || isEmail)
        {
            CancelMemberSearch();
            return;
        }

        memberSearchCts?.Cancel();
        memberSearchCts?.Dispose();

        var searchCts = new CancellationTokenSource();
        memberSearchCts = searchCts;
        showMemberSuggestions = true;
        isSearchingMembers = true;

        try
        {
            await Task.Delay(250, searchCts.Token);
            var results = await ApiClient.SearchMembersAsync(query, searchCts.Token);

            if (memberSearchCts != searchCts)
                return;

            memberSearchResults = results;
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke or a selected member superseded this search.
        }
        catch
        {
            if (memberSearchCts == searchCts)
                memberSearchError = "Member search is unavailable. You can still enter their exact username or email address.";
        }
        finally
        {
            if (memberSearchCts == searchCts)
                isSearchingMembers = false;
        }
    }

    private void SelectInvitee(Shandis.Web.Models.MemberSearchItem member)
    {
        CancelMemberSearch();
        selectedInvitee = member;
        inviteIdentifier = $"@{member.UserName}";
        memberSearchResults = [];
        memberSearchError = null;
        showMemberSuggestions = false;
        invitationMessage = null;
    }

    private void CancelMemberSearch()
    {
        memberSearchCts?.Cancel();
        memberSearchCts?.Dispose();
        memberSearchCts = null;
        isSearchingMembers = false;
        showMemberSuggestions = false;
        memberSearchResults = [];
    }

    private async Task SendInvitationAsync()
    {
        if (string.IsNullOrWhiteSpace(inviteIdentifier) || isSendingInvitation)
            return;

        isSendingInvitation = true;
        invitationMessage = null;
        invitationIsError = false;

        try
        {
            var enteredInvitee = selectedInvitee?.UserName ?? inviteIdentifier.Trim();
            var invitedByUserName = selectedInvitee is not null ||
                enteredInvitee.StartsWith("@", StringComparison.Ordinal) ||
                !enteredInvitee.Contains("@", StringComparison.Ordinal);

            await ApiClient.CreateInvitationAsync(MemoryId, enteredInvitee, inviteRole);

            inviteIdentifier = string.Empty;
            selectedInvitee = null;
            CancelMemberSearch();
            memoryInvitations = await ApiClient.GetMemoryInvitationsAsync(MemoryId);
            invitationMessage = invitedByUserName
                ? "Invitation sent to the Shandis member. They'll see it in their notifications and can accept it from Shared with Me."
                : "Invitation saved. If this email belongs to an existing member, they'll receive an in-app notification. Email delivery for new members still needs to be configured.";
        }
        catch (Exception ex)
        {
            invitationIsError = true;
            invitationMessage = GetFriendlyInvitationError(ex);
        }
        finally
        {
            isSendingInvitation = false;
        }
    }

    private static string GetFriendlyInvitationError(Exception exception)
    {
        var message = exception.Message;

        if (exception is HttpRequestException)
        {
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(message);
                if (document.RootElement.TryGetProperty("message", out var messageElement))
                    message = messageElement.GetString() ?? message;
            }
            catch (System.Text.Json.JsonException)
            {
                // The response was not a JSON error payload.
            }

            if (message.Contains("No Shandis member was found", StringComparison.OrdinalIgnoreCase))
                return "We couldn't find a Shandis member with that username. Check the spelling, choose someone from the suggestions, or enter their email address.";

            if (message.Contains("cannot invite yourself", StringComparison.OrdinalIgnoreCase))
                return "You can't invite yourself to your own Memory.";

            if (message.Contains("does not have a usable email address", StringComparison.OrdinalIgnoreCase))
                return "This member doesn't have an email address available for invitations.";

            return "We couldn't send the invitation right now. Please check the details and try again.";
        }

        return "Something went wrong while sending the invitation. Please try again.";
    }

    private async Task RevokeInvitationAsync(Guid invitationId)
    {
        if (!busyInvitationIds.Add(invitationId))
            return;

        invitationMessage = null;
        try
        {
            await ApiClient.RevokeInvitationAsync(invitationId);
            memoryInvitations = await ApiClient.GetMemoryInvitationsAsync(MemoryId);
            invitationMessage = "Invitation revoked.";
            invitationIsError = false;
        }
        catch (Exception ex)
        {
            invitationMessage = ex.Message;
            invitationIsError = true;
        }
        finally
        {
            busyInvitationIds.Remove(invitationId);
        }
    }

    private static string InvitationStatusText(int status) => status switch
    {
        1 => "Pending",
        2 => "Accepted",
        3 => "Declined",
        4 => "Revoked",
        5 => "Expired",
        _ => "Unknown"
    };

    private void RebuildGallery()
    {
        galleryItems = moments
            .SelectMany(moment => moment.Media
                .OrderBy(media => media.SortOrder)
                .Where(media => media.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
                    || media.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                .Select(media => new GalleryItem
                {
                    Moment = moment,
                    Media = media,
                    IsVideo = media.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase)
                }))
            .ToList();
    }

    private string FilterClass(string filter) =>
        galleryFilter == filter ? "active" : string.Empty;

    private void SetGalleryFilter(string filter)
    {
        galleryFilter = filter;
        selectedGalleryItem = null;
    }

    private async Task OpenGallery(GalleryItem item)
    {
        selectedGalleryItem = item;
        selectedGalleryIndex = galleryItems.FindIndex(candidate => candidate.Media.Id == item.Media.Id);
        galleryNewCommentContent = string.Empty;
        galleryCommentError = null;
        await LoadGalleryCommentsAsync(item.Moment.Id);
    }

    private async Task OpenMomentFirstMedia(Shandis.Web.Models.MomentItem moment)
    {
        var item = galleryItems.FirstOrDefault(candidate => candidate.Moment.Id == moment.Id);
        if (item is not null)
            await OpenGallery(item);
    }

    private void CloseGallery()
    {
        selectedGalleryItem = null;
        galleryComments = [];
        galleryCommentsError = null;
        galleryCommentError = null;
    }

    private async Task PreviousGalleryItem()
    {
        if (selectedGalleryIndex <= 0) return;
        selectedGalleryIndex--;
        selectedGalleryItem = galleryItems[selectedGalleryIndex];
        galleryNewCommentContent = string.Empty;
        await LoadGalleryCommentsAsync(selectedGalleryItem.Moment.Id);
    }

    private async Task NextGalleryItem()
    {
        if (selectedGalleryIndex >= galleryItems.Count - 1) return;
        selectedGalleryIndex++;
        selectedGalleryItem = galleryItems[selectedGalleryIndex];
        galleryNewCommentContent = string.Empty;
        await LoadGalleryCommentsAsync(selectedGalleryItem.Moment.Id);
    }

    private async Task LoadGalleryCommentsAsync(Guid momentId)
    {
        galleryComments = [];
        galleryCommentsError = null;
        galleryCommentsLoading = true;

        try
        {
            var page = 1;
            var totalCount = 0;
            const int commentsPageSize = 100;

            do
            {
                var result = await ApiClient.GetMomentCommentsAsync(
                    momentId,
                    page,
                    commentsPageSize);

                if (selectedGalleryItem?.Moment.Id != momentId)
                    return;

                galleryComments.AddRange(result.Comments);
                totalCount = result.TotalCount;
                page++;
            }
            while ((page - 1) * commentsPageSize < totalCount);
        }
        catch
        {
            galleryCommentsError = "Comments couldn't be loaded. Please try again.";
        }
        finally
        {
            galleryCommentsLoading = false;
        }
    }

    private async Task PostGalleryCommentAsync()
    {
        if (selectedGalleryItem is null ||
            string.IsNullOrWhiteSpace(galleryNewCommentContent) ||
            galleryCommentPosting)
            return;

        galleryCommentPosting = true;
        galleryCommentError = null;

        try
        {
            var moment = selectedGalleryItem.Moment;
            var created = await ApiClient.CreateMomentCommentAsync(
                moment.Id,
                galleryNewCommentContent.Trim());

            galleryComments.Add(created);
            moment.CommentCount++;
            galleryNewCommentContent = string.Empty;
        }
        catch
        {
            galleryCommentError = "Your comment couldn't be posted. Please try again.";
        }
        finally
        {
            galleryCommentPosting = false;
        }
    }

    private static string Initials(string title)
    {
        var parts = title.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "S";
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private async Task ModerateMomentAsync(Guid momentId, bool approve)
    {
        if (memory?.MyRole != 1 || !moderatingMomentIds.Add(momentId))
            return;

        moderationMessage = null;
        moderationIsError = false;

        try
        {
            if (approve)
                await ApiClient.ApproveMomentAsync(momentId);
            else
                await ApiClient.RejectMomentAsync(momentId);

            var result = await ApiClient.GetMomentsAsync(MemoryId, 1, PageSize);
            moments = result.Moments;
            momentsPage = result.Page;
            momentsTotal = result.TotalCount;
            momentsTotalPages = result.TotalPages;
            RebuildGallery();

            moderationMessage = approve
                ? "Contribution approved. It is now visible to people who can view this Memory."
                : "Contribution rejected. It will not be shown to other viewers.";
        }
        catch (Exception ex)
        {
            moderationIsError = true;
            moderationMessage = ex.Message;
        }
        finally
        {
            moderatingMomentIds.Remove(momentId);
        }
    }

    private async Task LoadMoreMomentsAsync()
    {
        if (isLoadingMore || momentsPage >= momentsTotalPages)
            return;

        isLoadingMore = true;
        try
        {
            var result = await ApiClient.GetMomentsAsync(MemoryId, momentsPage + 1, PageSize);
            moments.AddRange(result.Moments);
            momentsPage = result.Page;
            momentsTotal = result.TotalCount;
            momentsTotalPages = result.TotalPages;
            RebuildGallery();
        }
        finally
        {
            isLoadingMore = false;
        }
    }

    private readonly HashSet<Guid> busyMomentIds = [];
    private readonly HashSet<Guid> moderatingMomentIds = [];
    private string? moderationMessage;
    private bool moderationIsError;
    private Guid? activeCommentsMomentId;
    private List<Shandis.Web.Models.MomentCommentItem> activeComments = [];
    private string newCommentContent = string.Empty;
    private bool commentsLoading;
    private bool isPostingComment;
    private string? commentsError;
    private string? momentActionError;

    private bool CanPostComment => !string.IsNullOrWhiteSpace(newCommentContent);

    private async Task ToggleMomentLikeAsync(Shandis.Web.Models.MomentItem moment)
    {
        if (!busyMomentIds.Add(moment.Id))
            return;

        momentActionError = null;
        try
        {
            var result = moment.IsLikedByCurrentUser
                ? await ApiClient.UnlikeMomentAsync(moment.Id)
                : await ApiClient.LikeMomentAsync(moment.Id);

            moment.LikeCount = result.LikeCount;
            moment.IsLikedByCurrentUser = result.IsLikedByCurrentUser;
        }
        catch (Exception)
        {
            momentActionError = "We couldn't update your like. Please try again.";
        }
        finally
        {
            busyMomentIds.Remove(moment.Id);
        }
    }

    private async Task ToggleCommentsAsync(Guid momentId)
    {
        if (activeCommentsMomentId == momentId)
        {
            activeCommentsMomentId = null;
            activeComments = [];
            commentsError = null;
            return;
        }

        activeCommentsMomentId = momentId;
        activeComments = [];
        commentsError = null;
        commentsLoading = true;

        try
        {
            var result = await ApiClient.GetMomentCommentsAsync(momentId);
            if (activeCommentsMomentId == momentId)
                activeComments = result.Comments;
        }
        catch (Exception)
        {
            commentsError = "Comments couldn't be loaded. Please try again.";
        }
        finally
        {
            commentsLoading = false;
        }
    }

    private async Task AddCommentAsync(Guid momentId)
    {
        var content = newCommentContent.Trim();
        if (string.IsNullOrWhiteSpace(content) || isPostingComment)
            return;

        isPostingComment = true;
        commentsError = null;

        try
        {
            var created = await ApiClient.CreateMomentCommentAsync(momentId, content);
            activeComments.Add(created);

            var moment = moments.FirstOrDefault(item => item.Id == momentId);
            if (moment is not null)
                moment.CommentCount++;

            newCommentContent = string.Empty;
        }
        catch (Exception)
        {
            commentsError = "Your comment couldn't be posted. Please try again.";
        }
        finally
        {
            isPostingComment = false;
        }
    }

    private sealed class GalleryItem
    {
        public required Shandis.Web.Models.MomentItem Moment { get; init; }
        public required Shandis.Web.Models.MomentMediaItem Media { get; init; }
        public bool IsVideo { get; init; }
    }
