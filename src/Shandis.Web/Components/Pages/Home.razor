@page "/"

<PageTitle>Home · Shandis</PageTitle>

<div class="home-page">
    <section class="welcome-row">
        <div>
            <p class="eyebrow">WEDNESDAY, 18 NOVEMBER</p>
            <h1>Your memories, <span>all together.</span></h1>
            <p class="welcome-copy">Every moment has a story. Pick up where you left off or start something new.</p>
        </div>
        <a class="shandis-btn shandis-btn-primary welcome-create" href="/memories/create">
            <span>+</span> Create a memory
        </a>
    </section>

    <section class="memory-stats" aria-label="Your Shandis overview">
        <article class="stat-card">
            <span class="stat-icon stat-coral">▧</span>
            <div><strong>12</strong><span>My memories</span></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon stat-sage">♡</span>
            <div><strong>8</strong><span>Shared with me</span></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon stat-gold">✳</span>
            <div><strong>46</strong><span>Moments added</span></div>
        </article>
    </section>

    <section class="section-block" id="my-memories">
        <div class="section-heading">
            <div><p class="eyebrow">YOUR COLLECTION</p><h2>Pick up the memories</h2></div>
            <a class="text-link" href="/#my-memories">View all <span>→</span></a>
        </div>
        <div class="memory-grid">
            <a class="memory-card" href="/memories">
                <div class="memory-cover cover-birthday">
                    <span class="cover-tag">YOUR MEMORY</span>
                    <span class="cover-date">08 NOV 2026</span>
                </div>
                <div class="memory-card-body">
                    <div class="memory-card-title"><h3>A little birthday magic</h3><span class="privacy-dot" title="Private memory">●</span></div>
                    <p>Johannesburg · 8 Nov 2026</p>
                    <div class="memory-card-footer"><span>♡ 18 Moments</span><span class="avatar-stack"><i>TM</i><i>LN</i><i>+4</i></span></div>
                </div>
            </a>
            <a class="memory-card" href="/memories">
                <div class="memory-cover cover-wedding">
                    <span class="cover-tag">CONTRIBUTING</span>
                    <span class="cover-date">24 OCT 2026</span>
                </div>
                <div class="memory-card-body">
                    <div class="memory-card-title"><h3>Thando &amp; Lwazi's day</h3><span class="privacy-dot public" title="Public memory">●</span></div>
                    <p>Hartbeespoort · 24 Oct 2026</p>
                    <div class="memory-card-footer"><span>♡ 64 Moments</span><span class="avatar-stack"><i>TL</i><i>SK</i><i>+12</i></span></div>
                </div>
            </a>
            <a class="memory-card" href="/memories">
                <div class="memory-cover cover-concert">
                    <span class="cover-tag">YOUR MEMORY</span>
                    <span class="cover-date">12 SEP 2026</span>
                </div>
                <div class="memory-card-body">
                    <div class="memory-card-title"><h3>That one summer show</h3><span class="privacy-dot">●</span></div>
                    <p>Pretoria · 12 Sep 2026</p>
                    <div class="memory-card-footer"><span>♡ 32 Moments</span><span class="avatar-stack"><i>TM</i><i>KB</i><i>+7</i></span></div>
                </div>
            </a>
        </div>
    </section>

    <section class="section-block shared-section" id="shared-with-me">
        <div class="section-heading">
            <div><p class="eyebrow">FROM YOUR PEOPLE</p><h2>Shared with you</h2></div>
            <a class="text-link" href="/#shared-with-me">See all <span>→</span></a>
        </div>
        <div class="shared-card">
            <div class="shared-avatar">LN</div>
            <div class="shared-description"><strong>Lesego invited you to a memory</strong><span>Family December Lunch · Contribution welcome</span></div>
            <span class="shared-time">2 hours ago</span>
            <a class="shandis-btn shandis-btn-secondary" href="/memories">Open memory</a>
        </div>
    </section>

    <section class="discover-banner" id="discover">
        <div><span class="discover-spark">✳</span><p class="eyebrow">GOOD MEMORIES ARE BETTER SHARED</p><h2>Have a moment worth keeping?</h2><p>Bring everyone's photos, videos and stories together in one place.</p></div>
        <a class="shandis-btn shandis-btn-primary" href="/memories/create">Start a memory <span>→</span></a>
    </section>
</div>
