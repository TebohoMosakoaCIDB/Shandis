@page "/memories"
@inject Shandis.Web.Services.ShandisAuthService AuthService
@inject Shandis.Web.Services.ShandisApiClient ApiClient

<PageTitle>My Memories · Shandis</PageTitle>

<div class="memories-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">YOUR COLLECTION</p>
            <h1>My memories</h1>
            <p class="page-intro">The experiences you've brought together and the moments you've helped preserve.</p>
        </div>
        <a class="shandis-btn shandis-btn-primary" href="/memories/create">＋ Create memory</a>
    </header>

    @if (isLoading)
    {
        <div class="memories-state"><span class="loading-pulse"></span><p>Gathering your memories…</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="memories-state state-error">
            <h2>We couldn't load your memories</h2>
            <p>@errorMessage</p>
            <button class="shandis-btn shandis-btn-secondary" @onclick="LoadMemoriesAsync">Try again</button>
        </div>
    }
    else if (memories.Count == 0)
    {
        <div class="memories-empty">
            <span class="empty-spark">✳</span>
            <h2>Your collection starts here.</h2>
            <p>Create a Memory for an experience you want to keep, then invite your people to add their perspectives.</p>
            <a class="shandis-btn shandis-btn-primary" href="/memories/create">Create your first memory</a>
        </div>
    }
    else
    {
        <div class="memories-results">
            <p class="results-count">@totalCount @(totalCount == 1 ? "memory" : "memories") in your collection</p>
            <div class="memory-list">
                @foreach (var memory in memories)
                {
                    <a class="memory-list-card" href="@($"/memories/{memory.Id}")">
                        <div class="memory-list-art">
                            <span class="art-spark">✳</span>
                            <span class="art-label">SHANDIS MEMORY</span>
                        </div>
                        <div class="memory-list-content">
                            <div class="memory-list-topline">
                                <span class="memory-role">@((memory.IsOwner) ? "YOU CREATED THIS" : "YOU CONTRIBUTED")</span>
                                <span class="visibility-pill">@((memory.Visibility == 0) ? "Private" : "Public")</span>
                            </div>
                            <h2>@memory.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(memory.Description))
                            {
                                <p class="memory-description">@memory.Description</p>
                            }
                            <div class="memory-meta">
                                @if (!string.IsNullOrWhiteSpace(memory.PlaceName))
                                {
                                    <span>⌖ @memory.PlaceName</span>
                                }
                                @if (memory.StartDateUtc.HasValue)
                                {
                                    <span>◷ @memory.StartDateUtc.Value.ToLocalTime().ToString("d MMM yyyy")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(memory.CategoryName))
                                {
                                    <span>✳ @memory.CategoryName</span>
                                }
                            </div>
                        </div>
                        <span class="memory-open-arrow">↗</span>
                    </a>
                }
            </div>
        </div>
    }
</div>

<style>
    .memories-page { max-width: 1120px; margin: 0 auto; padding: 30px 34px 70px; }
    .page-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:34px; }
    .eyebrow { color:var(--shandis-primary); font-size:10px; font-weight:800; letter-spacing:.15em; margin:0 0 9px; }
    .page-heading h1 { font-size:clamp(30px,4vw,42px); font-weight:800; margin:0; }
    .page-intro { color:var(--shandis-text-muted); margin:9px 0 0; max-width:580px; line-height:1.6; }
    .memories-results { margin-top:20px; }
    .results-count { color:var(--shandis-text-muted); font-size:12px; margin:0 0 14px; }
    .memory-list { display:grid; gap:13px; }
    .memory-list-card { display:flex; align-items:center; gap:20px; padding:15px; background:var(--shandis-surface); border:1px solid var(--shandis-border); border-radius:18px; box-shadow:var(--shandis-shadow); transition:transform .15s,border-color .15s; }
    .memory-list-card:hover { transform:translateY(-2px); border-color:var(--shandis-primary); }
    .memory-list-art { width:132px; min-width:132px; height:112px; border-radius:13px; background:linear-gradient(145deg,#F6C7B8,#EBA58F 55%,#D98573); display:flex; flex-direction:column; justify-content:space-between; padding:13px; color:#63382F; }
    .art-spark { font-size:27px; }.art-label { font-size:8px; font-weight:900; letter-spacing:.12em; }
    .memory-list-content { min-width:0; flex:1; }
    .memory-list-topline { display:flex; align-items:center; gap:10px; margin-bottom:7px; }
    .memory-role { color:var(--shandis-primary); font-size:9px; font-weight:800; letter-spacing:.1em; }
    .visibility-pill { border:1px solid var(--shandis-border); border-radius:30px; padding:3px 8px; color:var(--shandis-text-muted); font-size:10px; }
    .memory-list-content h2 { font-size:19px; margin:0 0 5px; font-weight:800; }
    .memory-description { color:var(--shandis-text-muted); margin:0 0 9px; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .memory-meta { display:flex; flex-wrap:wrap; gap:13px; color:var(--shandis-text-muted); font-size:11px; }
    .memory-open-arrow { color:var(--shandis-primary); font-size:20px; padding:0 8px; }
    .memories-state,.memories-empty { min-height:300px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:36px; background:var(--shandis-surface); border:1px solid var(--shandis-border); border-radius:22px; }
    .memories-state p,.memories-empty p { color:var(--shandis-text-muted); max-width:470px; line-height:1.65; }
    .memories-state h2,.memories-empty h2 { font-size:23px; margin:10px 0 0; }
    .empty-spark { display:grid; place-items:center; width:58px; height:58px; border-radius:18px; color:var(--shandis-primary); background:var(--shandis-primary-soft); font-size:29px; }
    .loading-pulse { width:26px; height:26px; border:3px solid var(--shandis-border); border-top-color:var(--shandis-primary); border-radius:50%; animation:spin .8s linear infinite; }
    @@keyframes spin { to { transform:rotate(360deg); } }
    @@media(max-width:650px) { .memories-page{padding:24px 17px 90px}.page-heading{align-items:flex-start;flex-direction:column}.memory-list-card{gap:12px;padding:10px}.memory-list-art{width:82px;min-width:82px;height:92px;padding:9px}.memory-list-content h2{font-size:15px}.memory-description{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.memory-meta{gap:7px}.memory-open-arrow{padding:0 2px} }
</style>

@code {
    private List<Shandis.Web.Models.MyMemoryItem> memories = [];
    private bool isLoading = true;
    private string? errorMessage;
    private int totalCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            await LoadMemoriesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadMemoriesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ApiClient.GetMyMemoriesAsync();
            memories = result.Items;
            totalCount = result.TotalCount;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Your session has expired. Please sign in again."
                : "Please check your connection and try again.";
        }
        catch (Exception)
        {
            errorMessage = "Something unexpected happened while loading your memories.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
