@page "/memories"
@inject Shandis.Web.Services.ShandisAuthService AuthService
@inject Shandis.Web.Services.ShandisApiClient ApiClient

<PageTitle>My Memories · Shandis</PageTitle>

<div class="my-memories-page">
    <header class="collection-heading">
        <div>
            <p class="eyebrow">YOUR PERSONAL COLLECTION</p>
            <h1>My Memories</h1>
            <p>Every experience you've helped bring together, all in one place.</p>
        </div>
        <a class="shandis-btn shandis-btn-primary" href="/memories/create">＋ Create Memory</a>
    </header>

    @if (isLoading)
    {
        <div class="collection-state"><span class="loading-pulse"></span><p>Gathering your memories…</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="collection-state"><h2>We couldn't load your collection</h2><p>@errorMessage</p><button class="shandis-btn shandis-btn-secondary" @onclick="LoadMemoriesAsync">Try again</button></div>
    }
    else if (memories.Count == 0)
    {
        <div class="collection-state"><span class="empty-symbol">✳</span><h2>Your first Memory is waiting.</h2><p>Create a space for an experience, then invite your people to add their photos, videos and stories.</p><a class="shandis-btn shandis-btn-primary" href="/memories/create">Create your first Memory</a></div>
    }
    else
    {
        <div class="collection-toolbar"><span>@totalCount @(totalCount == 1 ? "Memory" : "Memories")</span><span>Recently added</span></div>
        <div class="memory-collection-grid">
            @foreach (var memory in memories)
            {
                <a class="collection-memory-card" href="@($"/memories/{memory.Id}")">
                    <div class="collection-cover palette-@((Math.Abs(memory.Id.GetHashCode()) % 5) + 1)">
                        <span class="collection-cover-spark">✳</span>
                        <span class="collection-cover-title">@memory.Title</span>
                        <span class="collection-cover-mark">SHANDIS MEMORY</span>
                    </div>
                    <div class="collection-card-body">
                        <div class="collection-card-meta">
                            <span>@(memory.IsOwner ? "CREATED BY YOU" : "YOU CONTRIBUTED")</span>
                            <span>@(memory.Visibility == 2 ? "PRIVATE" : "PUBLIC")</span>
                        </div>
                        <h2>@memory.Title</h2>
                        <p>@(memory.PlaceName ?? "Location not set") · @(memory.StartDateUtc?.ToLocalTime().ToString("d MMM yyyy") ?? "Date not set")</p>
                        @if (!string.IsNullOrWhiteSpace(memory.Description))
                        {
                            <div class="collection-description">@memory.Description</div>
                        }
                        <div class="collection-card-footer"><span>@(memory.CategoryName ?? "Memory")</span><b>Open Memory ↗</b></div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<style>
    .my-memories-page{max-width:1040px;margin:0 auto;padding:8px 0 60px}
    .collection-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:27px}
    .eyebrow{margin:0 0 7px;color:var(--shandis-primary);font-size:9px;font-weight:850;letter-spacing:.15em}
    .collection-heading h1{margin:0;font:850 clamp(28px,4vw,38px) Manrope,sans-serif;letter-spacing:-.045em}
    .collection-heading p:last-child{margin:8px 0 0;color:var(--shandis-text-muted);font-size:12px}
    .collection-toolbar{display:flex;justify-content:space-between;margin-bottom:13px;color:var(--shandis-text-muted);font-size:10px}
    .memory-collection-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
    .collection-memory-card{overflow:hidden;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:16px;transition:transform .15s,box-shadow .15s}
    .collection-memory-card:hover{transform:translateY(-3px);box-shadow:var(--shandis-shadow)}
    .collection-cover{position:relative;display:flex;height:190px;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:20px;color:#49342E;text-align:center}
    .palette-1{background:linear-gradient(135deg,#E9B8A7,#F4D8C2 52%,#C6D6C6)}.palette-2{background:linear-gradient(135deg,#C5D8CD,#E8D5BE 52%,#E4A99A)}.palette-3{background:linear-gradient(135deg,#E7C98E,#F1E2C5 52%,#D3B7C7)}.palette-4{background:linear-gradient(135deg,#B8CFC4,#E6D4B9 52%,#DDA99D)}.palette-5{background:linear-gradient(135deg,#D6B9C8,#EBD4C1 52%,#B8CDC4)}
    .collection-cover-spark{font-size:29px;opacity:.75}.collection-cover-title{max-width:95%;font:850 22px/1.15 Manrope,sans-serif;letter-spacing:-.04em}.collection-cover-mark{font-size:8px;font-weight:900;letter-spacing:.2em;opacity:.7}
    .collection-card-body{padding:14px}
    .collection-card-meta{display:flex;justify-content:space-between;gap:8px;color:var(--shandis-primary);font-size:8px;font-weight:850;letter-spacing:.09em}
    .collection-card-meta span:last-child{color:var(--shandis-text-muted)}
    .collection-card-body h2{margin:9px 0 5px;font:800 14px Manrope,sans-serif}
    .collection-card-body>p{margin:0;color:var(--shandis-text-muted);font-size:9px}
    .collection-description{overflow:hidden;margin-top:8px;color:var(--shandis-text-muted);font-size:10px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
    .collection-card-footer{display:flex;justify-content:space-between;gap:8px;margin-top:13px;padding-top:10px;border-top:1px solid var(--shandis-border);color:var(--shandis-text-muted);font-size:9px}
    .collection-card-footer b{color:var(--shandis-primary)}
    .collection-state{min-height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px;background:var(--shandis-surface);border:1px solid var(--shandis-border);border-radius:17px;text-align:center}
    .collection-state h2{margin:10px 0 3px;font-size:20px}.collection-state p{max-width:410px;color:var(--shandis-text-muted);font-size:11px;line-height:1.7}
    .empty-symbol{font-size:38px;color:var(--shandis-primary)}
    .loading-pulse{width:25px;height:25px;border:3px solid var(--shandis-border);border-top-color:var(--shandis-primary);border-radius:50%;animation:spin .8s linear infinite}
    @@keyframes spin{to{transform:rotate(360deg)}}
    @@media(max-width:850px){.memory-collection-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @@media(max-width:540px){.collection-heading{align-items:flex-start;flex-direction:column}.memory-collection-grid{grid-template-columns:1fr}.collection-cover{height:165px}}
</style>

@code {
    private List<Shandis.Web.Models.MyMemoryItem> memories = [];
    private bool isLoading = true;
    private string? errorMessage;
    private int totalCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            await LoadMemoriesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadMemoriesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ApiClient.GetMyMemoriesAsync();
            memories = result.Items;
            totalCount = result.TotalCount;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Your session has expired. Please sign in again."
                : "Please check your connection and try again.";
        }
        catch (Exception)
        {
            errorMessage = "Something unexpected happened while loading your memories.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
