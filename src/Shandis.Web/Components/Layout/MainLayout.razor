@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject Shandis.Web.Services.ShandisAuthService AuthService
@inject NavigationManager Navigation
@inject Shandis.Web.Services.ShandisApiClient ApiClient

<div class="shandis-shell">
    <aside class="shandis-sidebar">
        <a class="brand-lockup" href="/" aria-label="Shandis home">
            <span class="brand-mark">s</span>
            <span class="brand-wordmark">shandis<span>.</span></span>
        </a>

        <a class="shandis-btn shandis-btn-primary sidebar-create" href="/memories/create">
            <span class="create-plus">+</span>
            Create memory
        </a>

        <NavMenu />

        <div class="sidebar-note">
            <span class="note-spark">✳</span>
            <p>One experience.<br />Many perspectives.</p>
            <span class="muted">One collective memory.</span>
        </div>
    </aside>

    <main class="shandis-main">
        <header class="shandis-topbar">
            <div class="mobile-brand">
                <span class="brand-mark">s</span>
                <span class="brand-wordmark">shandis<span>.</span></span>
            </div>
            <div class="topbar-spacer"></div>
            <button class="shandis-icon-btn theme-toggle" type="button"
                    aria-label="Toggle colour theme" title="Toggle light and dark theme"
                    @onclick="ToggleThemeAsync">
                <span aria-hidden="true">◐</span>
            </button>
            @if (AuthService.IsAuthenticated)
            {
                <button class="profile-chip" type="button" @onclick="LogoutAsync" title="Signed in as @CurrentUserLabel — sign out">
                    <span class="profile-avatar">@CurrentUserInitials</span>
                    <span class="profile-identity">
                        <span class="profile-name">@CurrentUserLabel</span>
                        <span class="profile-presence"><span class="online-indicator"></span>Online</span>
                    </span>
                    <span class="profile-chevron">↗</span>
                </button>
            }
            else
            {
                <a class="profile-chip" href="/login">
                    <span class="profile-avatar">S</span>
                    <span class="profile-name">Sign in</span>
                    <span class="profile-chevron">↗</span>
                </a>
            }
        </header>

        <section class="shandis-content">
            @Body
        </section>
    </main>
</div>

<div class="mobile-create-wrap">
    <a class="mobile-create-button" href="/memories/create" aria-label="Create a memory">+</a>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();

            if (!AuthService.IsAuthenticated)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            try
            {
                currentUser = await ApiClient.GetMyProfileAsync();
            }
            catch
            {
                // Keep the authenticated shell usable if the profile endpoint is temporarily unavailable.
            }

            StateHasChanged();
        }
    }

    private string CurrentUserLabel =>
        !string.IsNullOrWhiteSpace(currentUser?.DisplayName)
            ? currentUser.DisplayName
            : $"{currentUser?.FirstName} {currentUser?.LastName}".Trim() is { Length: > 0 } fullName
                ? fullName
                : currentUser?.Email ?? "Signed in";

    private string CurrentUserInitials
    {
        get
        {
            var name = CurrentUserLabel;
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0)
                return "U";

            return parts.Length == 1
                ? parts[0][..1].ToUpperInvariant()
                : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }
    }

    private Shandis.Web.Models.UserProfileItem? currentUser;

    private async Task ToggleThemeAsync()
    {
        await JS.InvokeVoidAsync("shandisTheme.toggle");
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}